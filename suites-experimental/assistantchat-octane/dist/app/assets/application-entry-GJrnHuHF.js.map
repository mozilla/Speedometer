import { useContext, useLayoutEffect, useRef } from 'octane';
import { useNavigate } from '@octanejs/tanstack-router';
import * as stylex from '@octanejs/stylex';
import { GatesContext, LocaleContext, TelemetryContext } from './contexts.ts';
import 'octane/signals';
import { canSend$, draft$, multiline$, sendDisabled$, sending$ } from './composer-state.tsrx';
import { env } from './env.ts';
import { Button } from '../ui/Button.tsrx';
import { Icon } from '../ui/Icon.tsrx';

const DRAFT_KEY = 'lumen:composer-draft';
const MAX_HEIGHT = 208;

const styles = stylex.create({
	dock: { flex: 'none', paddingInline: 'var(--lm-space-24)', paddingBlockEnd: 'var(--lm-space-8)', backgroundColor: 'var(--lm-surface-canvas-default)' },
	form: {
		display: 'flex',
		flexDirection: 'column',
		maxWidth: 'var(--lm-thread-max)',
		marginInline: 'auto',
		paddingBlock: 'var(--lm-space-10)',
		paddingInline: 'var(--lm-space-12)',
		borderWidth: 1,
		borderStyle: 'solid',
		borderColor: 'var(--lm-border-composer)',
		borderRadius: 'var(--lm-radius-3xl)',
		backgroundColor: 'var(--lm-surface-composer-default)',
		boxShadow: 'var(--lm-shadow-2)',
	},
	row: { display: 'flex', alignItems: 'flex-end', gap: 'var(--lm-space-8)' },
	textarea: {
		flex: 1,
		minHeight: 28,
		maxHeight: MAX_HEIGHT,
		paddingBlock: 'var(--lm-space-6)',
		paddingInline: 'var(--lm-space-4)',
		borderWidth: 0,
		outline: 'none',
		resize: 'none',
		backgroundColor: 'transparent',
		lineHeight: 'var(--lm-line-height-base)',
		overflowY: 'auto',
		'::placeholder': { color: 'var(--lm-text-placeholder)' },
	},
	tools: { display: 'flex', alignItems: 'center', gap: 'var(--lm-space-4)', opacity: 0.85 },
	send: { width: 36, height: 36, borderRadius: 'var(--lm-radius-full)' },
	disclaimer: { margin: 0, paddingBlockStart: 'var(--lm-space-8)', textAlign: 'center', fontSize: 'var(--lm-font-size-xs)', color: 'var(--lm-text-tertiary)' },
});

const TOOLS = [
	['image', 'Create an image'],
	['globe', 'Search the web'],
	['library', 'Deep research'],
	['code', 'Write or code'],
	['sparkle', 'Think longer'],
	['edit', 'Canvas'],
	['grid', 'Explore apps'],
	['pin', 'Add from saved'],
	['archive', 'Projects'],
	['link', 'Connect a source'],
	['user', 'Agent mode'],
	['help', 'Learn about tools'],
];

// The tools menu is part of the server HTML and stays hidden until opened.
function ToolsMenu() @{
	<div class="lm-menu" role="menu" hidden aria-label="Tools">
		@for (const tool of TOOLS; key tool[1]) {
			<button type="button" role="menuitem" class="lm-menu-item" data-tool={tool[0]}>
				<Icon name={tool[0]} />
				<span>{tool[1]}</span>
				<Icon class="lm-menu-chevron" name="chevron-right" />
			</button>
		}
	</div>
}

function readDraft() {
	try {
		return sessionStorage.getItem(DRAFT_KEY) ?? '';
	} catch {
		return '';
	}
}

function persistDraft(value) {
	try {
		if (value)
			sessionStorage.setItem(DRAFT_KEY, JSON.stringify({ text: value, at: env.now, v: 2 }));
		else
			sessionStorage.removeItem(DRAFT_KEY);
	} catch {}
}

// Navigates to the thread and resolves once its route has mounted; a
// follow-up in the open thread resolves at once.
function openThread(navigate, threadId) {
	if (document.querySelector('.lm-thread-column'))
		return;
	const mounted = new Promise((resolve) => {
		const onReady = (event) => {
			if (event.detail !== 'thread')
				return;
			window.removeEventListener('chat:route-ready', onReady);
			resolve();
		};
		window.addEventListener('chat:route-ready', onReady);
	});
	navigate({ to: '/c/$threadId', params: { threadId } });
	return mounted;
}

// Grows the textarea with its content up to the maximum height: reset the
// height, read the content height, write it back.
function autosize(textarea) {
	textarea.style.height = 'auto';
	const height = Math.min(textarea.scrollHeight, MAX_HEIGHT);
	textarea.style.height = `${height}px`;
	textarea.closest('.lm-main')?.style.setProperty('--lm-composer-height', `${height + 52}px`);
}

export function Composer() @{
	const { strings } = useContext(LocaleContext);
	const telemetry = useContext(TelemetryContext);
	const gates = useContext(GatesContext);
	const navigate = useNavigate();
	const textarea = useRef(null);
	const showVoice = gates.checkGate('composer_voice_entry');
	const placeholder = gates.getLayer('composer_copy').get('placeholder', strings.composerPlaceholder);
	useLayoutEffect(() => {
		if (readDraft())
			persistDraft('');
		autosize(textarea.current);
	}, []);
	const submit = async () => {
		if (!canSend$.get())
			return;
		const prompt = draft$.get().trim();
		draft$.set('');
		textarea.current.value = '';
		persistDraft('');
		autosize(textarea.current);
		sending$.set(true);
		const { sendPrompt } = await import('../conversation/stream-client.ts');
		await sendPrompt(prompt, {
			telemetry,
			onThread: (path) => openThread(navigate, path.split('/').pop()),
			onRevision: () => {},
			onComplete: () => {
				sending$.set(false);
				env.signal('reply-complete');
			},
		});
	};
	<div class="lm-composer-dock">
		<div {...stylex.props(styles.dock)}>
			<form
				class={['lm-composer', stylex.props(styles.form).className]}
				method="post"
				action="api/conversation"
				onSubmit={(event) => {
					event.preventDefault();
					env.track(submit());
				}}
			>
				<div class={['lm-composer-row', stylex.props(styles.row).className]}>
					<Button icon="plus" aria={strings.attach} action="attach" />
					<label class="lm-sr-only" for="prompt-textarea">{strings.composerLabel}</label>
					<textarea
						ref={textarea}
						id="prompt-textarea"
						name="prompt"
						rows={1}
						placeholder={placeholder}
						value={draft$}
						data-multiline={multiline$}
						{...stylex.props(styles.textarea)}
						onInput={(event) => {
							autosize(event.currentTarget);
							persistDraft(event.currentTarget.value);
						}}
						onKeyDown={(event) => {
							if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
								event.preventDefault();
								event.currentTarget.form.requestSubmit();
							}
						}}
					/>
					<div class={['lm-composer-tools', stylex.props(styles.tools).className]}>
						<Button icon="tools" aria={strings.tools} action="tools" haspopup="menu" expanded="false" />
						<ToolsMenu />
						@if (showVoice) {
							<Button icon="mic" aria={strings.voice} action="voice" />
						}
						<button type="submit" class={['lm-send', stylex.props(styles.send).className]} aria-label={strings.send} data-action="send" disabled={sendDisabled$}>
							<Icon name="send" />
						</button>
					</div>
				</div>
			</form>
			<p {...stylex.props(styles.disclaimer)}>{strings.disclaimer}</p>
		</div>
	</div>
}
