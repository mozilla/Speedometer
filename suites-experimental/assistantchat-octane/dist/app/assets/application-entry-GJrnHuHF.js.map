import { useLayoutEffect, useRef } from 'octane';
import * as stylex from '@octanejs/stylex';
import { trapFocus } from './focus-trap.ts';

const styles = stylex.create({
	scrim: {
		position: 'fixed',
		inset: 0,
		zIndex: 'var(--lm-z-dialog)',
		display: 'grid',
		placeItems: 'center',
		backgroundColor: 'rgb(0 0 0 / 0.45)',
	},
	dialog: {
		position: 'static',
		width: 'min(440px, calc(100% - 32px))',
		margin: 0,
		padding: 'var(--lm-space-24)',
		borderWidth: 0,
		borderRadius: 'var(--lm-radius-2xl)',
		backgroundColor: 'var(--lm-surface-dialog-default)',
		color: 'var(--lm-text-primary)',
		boxShadow: 'var(--lm-shadow-5)',
	},
	title: { margin: 0, marginBlockEnd: 'var(--lm-space-8)', fontSize: 'var(--lm-font-size-lg)', fontWeight: 'var(--lm-font-weight-semibold)' },
	body: { margin: 0, color: 'var(--lm-text-secondary)', fontSize: 'var(--lm-font-size-md)' },
	actions: { display: 'flex', justifyContent: 'flex-end', gap: 'var(--lm-space-8)', marginBlockStart: 'var(--lm-space-24)' },
});

export function Dialog(props) @{
	const ref = useRef(null);
	useLayoutEffect(() => {
		const release = trapFocus(ref.current);
		const onKey = (event) => {
			if (event.key === 'Escape')
				props.onClose();
		};
		ref.current.addEventListener('keydown', onKey);
		return () => {
			ref.current?.removeEventListener('keydown', onKey);
			release();
		};
	}, []);
	<div {...stylex.props(styles.scrim)}>
		<dialog open ref={ref} role="alertdialog" class={['lm-dialog', stylex.props(styles.dialog).className]} aria-labelledby={props.id + '-title'} aria-modal="true" data-dialog={props.id}>
			<h2 id={props.id + '-title'} {...stylex.props(styles.title)}>{props.title}</h2>
			<p {...stylex.props(styles.body)}>{props.body}</p>
			<div {...stylex.props(styles.actions)}>{props.children}</div>
		</dialog>
	</div>
}
