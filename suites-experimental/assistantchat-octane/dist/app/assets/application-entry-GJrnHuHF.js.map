import { useContext } from 'octane';
import { useNavigate } from '@octanejs/tanstack-router';
import * as stylex from '@octanejs/stylex';
import { ActionsContext, LayoutContext, LocaleContext, TelemetryContext } from './contexts.ts';
import { Button } from '../ui/Button.tsrx';
import { Icon } from '../ui/Icon.tsrx';

const styles = stylex.create({
	header: {
		display: 'flex',
		alignItems: 'center',
		gap: 'var(--lm-space-8)',
		height: 'var(--lm-header-height)',
		flex: 'none',
		paddingInline: 'var(--lm-space-12)',
		backgroundColor: 'var(--lm-surface-canvas-default)',
		zIndex: 'var(--lm-z-header)',
	},
	model: {
		display: 'inline-flex',
		alignItems: 'center',
		gap: 'var(--lm-space-4)',
		height: 36,
		paddingInline: 'var(--lm-space-10)',
		borderWidth: 0,
		borderRadius: 'var(--lm-radius-lg)',
		backgroundColor: { default: 'transparent', ':hover': 'var(--lm-surface-hover-default)' },
		fontSize: 'var(--lm-font-size-lg)',
		fontWeight: 'var(--lm-font-weight-medium)',
	},
	spacer: { flex: 1 },
	slot: { display: 'contents' },
});

export function Header(props) @{
	const { strings } = useContext(LocaleContext);
	const layout = useContext(LayoutContext);
	const actions = useContext(ActionsContext);
	const telemetry = useContext(TelemetryContext);
	const navigate = useNavigate();
	<header class={['lm-header', stylex.props(styles.header).className]}>
		@if (!layout.sidebarOpen) {
			<>
				<Button class="lm-header-sidebar-toggle" icon="sidebar" aria={strings.openSidebar} action="open-sidebar" onClick={actions.toggleSidebar} />
				<Button icon="compose" aria={strings.newChat} action="new-chat-header" onClick={props.onNewChat} />
			</>
		}
		<button type="button" {...stylex.props(styles.model)} aria-haspopup="menu" onClick={() => telemetry.business('model_menu_opened', {})}>
			<span>{strings.model}</span>
			<Icon name="chevron" />
		</button>
		<div {...stylex.props(styles.spacer)} />
		<div class={['lm-slot', stylex.props(styles.slot).className]} data-slot="thread-controls" dangerouslySetInnerHTML={{ __html: '<?start name="thread-controls"><?end>' }} />
		<Button variant="primary" size="sm" label={strings.signIn} action="sign-in" />
		<Button variant="secondary" size="sm" label={strings.signUp} action="sign-up" />
		<Button icon="settings" aria={strings.settings} action="open-settings" onClick={() => navigate({ to: '/settings' })} />
	</header>
}
