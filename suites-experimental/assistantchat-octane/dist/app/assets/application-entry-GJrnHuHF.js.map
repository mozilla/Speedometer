import { useContext } from 'octane';
import { useNavigate } from '@octanejs/tanstack-router';
import { LocaleContext, TelemetryContext } from './contexts.ts';
import { conversation } from '../conversation/store.ts';
import { Dialog } from '../ui/Dialog.tsrx';
import { Button } from '../ui/Button.tsrx';
import { env } from './env.ts';

export function NewChatDialog(props) @{
	const { strings } = useContext(LocaleContext);
	const telemetry = useContext(TelemetryContext);
	const navigate = useNavigate();
	const clear = () => {
		telemetry.business('chat_cleared', { turns: conversation.getSnapshot().turns.length });
		props.onClose();
		env.track(import('../genui/client.ts').then((client) => client.resetWorker()));
		conversation.reset();
		navigate({ to: '/' });
		env.signal('chat-cleared');
	};
	<Dialog id="clear-chat" title={strings.clearChatTitle} body={strings.clearChatBody} onClose={props.onClose}>
		<Button variant="secondary" label={strings.cancel} action="cancel" onClick={props.onClose} />
		<Button variant="danger" label={strings.clearChat} action="clear-chat" onClick={clear} />
	</Dialog>
}
