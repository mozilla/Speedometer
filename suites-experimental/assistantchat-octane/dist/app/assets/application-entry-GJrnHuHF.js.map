import { derived$, signal$ } from 'octane/signals';

// The composer's draft and the states derived from it. The send button and
// the multi-line layout bind to them directly.
export const draft$ = signal$('');
export const sending$ = signal$(false);
export const canSend$ = derived$(() => draft$.get().trim().length > 0 && !sending$.get());
export const sendDisabled$ = derived$(() => !canSend$.get());
export const multiline$ = derived$(() => (draft$.get().length > 64 || draft$.get().includes('\n') ? 'true' : 'false'));
