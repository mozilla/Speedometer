import { useContext, useLayoutEffect, useRef, useState } from 'octane';
import * as stylex from '@octanejs/stylex';
import { ActionsContext, GatesContext, LocaleContext, TelemetryContext } from './contexts.ts';
import { env } from './env.ts';
import { Button } from '../ui/Button.tsrx';
import { Icon } from '../ui/Icon.tsrx';

const styles = stylex.create({
	sidebar: {
		display: 'flex',
		flexDirection: 'column',
		minWidth: 0,
		height: '100vh',
		overflow: 'hidden',
		backgroundColor: 'var(--lm-surface-sidebar-default)',
		borderInlineEndWidth: 1,
		borderInlineEndStyle: 'solid',
		borderInlineEndColor: 'var(--lm-border-sidebar)',
		zIndex: 'var(--lm-z-sidebar)',
	},
	inner: { display: 'flex', flexDirection: 'column', width: 'var(--lm-sidebar-width)', height: '100%', padding: 'var(--lm-space-8)', gap: 'var(--lm-space-4)' },
	top: { display: 'flex', alignItems: 'center', justifyContent: 'space-between', height: 'var(--lm-header-height)', paddingInline: 'var(--lm-space-4)' },
	brand: { display: 'inline-flex', alignItems: 'center', gap: 'var(--lm-space-8)', fontWeight: 'var(--lm-font-weight-semibold)', color: 'var(--lm-accent-text)' },
	item: {
		display: 'flex',
		alignItems: 'center',
		gap: 'var(--lm-space-10)',
		width: '100%',
		height: 36,
		paddingInline: 'var(--lm-space-10)',
		borderWidth: 0,
		borderRadius: 'var(--lm-radius-lg)',
		backgroundColor: { default: 'transparent', ':hover': 'var(--lm-surface-hover-default)' },
		color: 'var(--lm-text-primary)',
		fontSize: 'var(--lm-font-size-md)',
		textAlign: 'start',
	},
	section: { marginBlockStart: 'var(--lm-space-16)', paddingInline: 'var(--lm-space-10)', fontSize: 'var(--lm-font-size-xs)', fontWeight: 'var(--lm-font-weight-semibold)', color: 'var(--lm-text-tertiary)' },
	empty: { paddingInline: 'var(--lm-space-10)', fontSize: 'var(--lm-font-size-sm)', color: 'var(--lm-text-tertiary)' },
	spacer: { flex: 1 },
	cta: { display: 'flex', flexDirection: 'column', gap: 'var(--lm-space-8)', padding: 'var(--lm-space-12)', borderRadius: 'var(--lm-radius-xl)', backgroundColor: 'var(--lm-surface-raised-default)' },
	ctaTitle: { margin: 0, fontSize: 'var(--lm-font-size-md)', fontWeight: 'var(--lm-font-weight-semibold)' },
	ctaText: { margin: 0, fontSize: 'var(--lm-font-size-sm)', color: 'var(--lm-text-secondary)' },
});

function NavItem(props) @{
	const telemetry = useContext(TelemetryContext);
	<button
		type="button"
		class={['lm-sidebar-item', stylex.props(styles.item).className]}
		data-nav={props.id}
		onClick={() => {
			telemetry.business('sidebar_nav_clicked', { item: props.id });
			props.onClick?.();
		}}
	>
		<Icon name={props.icon} />
		<span>{props.label}</span>
	</button>
}

// The sidebar keeps its content laid out at full width while it collapses;
// the grid track animates. A real page commits the closed state on
// transitionend, the benchmark at the end of the step.
export function Sidebar(props) @{
	const { strings } = useContext(LocaleContext);
	const actions = useContext(ActionsContext);
	const gates = useContext(GatesContext);
	const ref = useRef(null);
	const [transition, setTransition] = useState('idle');
	const first = useRef(true);
	useLayoutEffect(() => {
		if (first.current) {
			first.current = false;
			return;
		}
		setTransition('running');
		const done = () => setTransition('idle');
		ref.current.addEventListener('transitionend', done, { once: true });
		env.onFlush(done);
	}, [props.open]);
	const showExplore = gates.checkGate('sidebar_explore_entry');
	<nav
		ref={ref}
		class={['lm-sidebar', stylex.props(styles.sidebar).className]}
		data-state={props.open ? 'open' : 'closed'}
		data-transition={transition}
		aria-label="Chat history"
		aria-hidden={props.open ? undefined : 'true'}
		inert={!props.open}
	>
		<div {...stylex.props(styles.inner)}>
			<div {...stylex.props(styles.top)}>
				<span {...stylex.props(styles.brand)}>
					<Icon name="logo" />
					<span>{strings.appName}</span>
				</span>
				<Button icon="sidebar" aria={strings.closeSidebar} action="close-sidebar" onClick={actions.toggleSidebar} />
			</div>
			<NavItem id="new" icon="compose" label={strings.newChat} onClick={props.onNewChat} />
			<NavItem id="search" icon="search" label={strings.searchChats} />
			<NavItem id="library" icon="library" label={strings.library} />
			@if (showExplore) {
				<NavItem id="explore" icon="grid" label={strings.explore} />
			}
			<div class={['lm-sidebar-section', stylex.props(styles.section).className]}>{'Chats'}</div>
			<p {...stylex.props(styles.empty)}>{'Sign in to save your chats.'}</p>
			<div {...stylex.props(styles.spacer)} />
			<div {...stylex.props(styles.cta)}>
				<p {...stylex.props(styles.ctaTitle)}>{'Get answers tailored to you'}</p>
				<p {...stylex.props(styles.ctaText)}>{'Sign in to keep your history, upload files and more.'}</p>
				<Button variant="primary" label={strings.signIn} action="sign-in" />
			</div>
		</div>
	</nav>
}
