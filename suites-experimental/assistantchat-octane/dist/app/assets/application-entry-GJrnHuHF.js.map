import { useMemo, useState } from 'octane';
import { RouterProvider } from '@octanejs/tanstack-router';
import { ActionsContext, GatesContext, LayoutContext, LocaleContext, SessionContext, TelemetryContext, ThemeContext } from './contexts.ts';
import { env } from './env.ts';

// The application frame: the providers every route reads, then the router.
export function App(props) @{
	const boot = props.boot;
	const [theme, setTheme] = useState(boot.theme);
	const [accent, setAccent] = useState(boot.accent);
	const [sidebarOpen, setSidebarOpen] = useState(boot.sidebarOpen);
	const [settings, setSettings] = useState(boot.settings);
	const locale = useMemo(() => ({ locale: boot.locale, strings: boot.strings }), [boot]);
	const themeValue = useMemo(() => ({ theme, accent, density: 'comfortable' }), [theme, accent]);
	const layout = useMemo(() => ({ sidebarOpen, width: boot.viewportWidth, compact: false }), [sidebarOpen]);
	const session = useMemo(() => ({ signedIn: false, persona: 'anonymous', region: boot.region }), [boot]);
	const actions = useMemo(() => ({
		setTheme(next) {
			setTheme(next);
			if (typeof document !== 'undefined')
				document.documentElement.dataset.theme = next;
			props.telemetry.business('settings_theme_changed', { theme: next });
		},
		setAccent,
		toggleSidebar() {
			setSidebarOpen((open) => !open);
		},
		setSetting(name, value) {
			setSettings((current) => ({ ...current, [name]: value }));
			props.telemetry.business('settings_changed', { name, value });
		},
		settings,
	}), [settings]);
	<LocaleContext value={locale}>
		<ThemeContext value={themeValue}>
			<SessionContext value={session}>
				<GatesContext value={props.gates}>
					<TelemetryContext value={props.telemetry}>
						<LayoutContext value={layout}>
							<ActionsContext value={actions}>
								<RouterProvider router={props.router} />
							</ActionsContext>
						</LayoutContext>
					</TelemetryContext>
				</GatesContext>
			</SessionContext>
		</ThemeContext>
	</LocaleContext>
}
