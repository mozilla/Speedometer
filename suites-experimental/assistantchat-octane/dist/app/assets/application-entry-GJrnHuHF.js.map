import 'virtual:stylex.css';
import './generated/tokens.css';
import './ui/global.css';
import { hydrateRoot } from 'octane';
import { createBrowserHistory } from '@octanejs/tanstack-router';
import { App } from './app/App.tsrx';
import { makeRouter } from './app/router.ts';
import { setBoot } from './app/boot.ts';
import { GateClient } from './gates/client.ts';
import { Telemetry } from './telemetry/events.ts';
import { env } from './app/env.ts';
import { startVitals } from './telemetry/vitals.ts';

const boot = JSON.parse(document.getElementById('app-state').textContent);
setBoot(boot);
const telemetry = new Telemetry({ app: 'lumen-web', build: boot.frame.build, persona: 'anonymous', locale: boot.locale });
const gates = new GateClient(boot.gates, (event) => telemetry.exposure(event));
const basepath = new URL('.', document.baseURI).pathname.replace(/\/$/, '') || '/';
const router = makeRouter({ history: createBrowserHistory(), basepath });

env.track((async () => {
	await router.load();
	hydrateRoot(document.getElementById('root'), App, { boot, router, gates, telemetry });
	(window as any).__chatBooted = true;
	telemetry.pageView(env.route());
	startVitals(telemetry);
	env.signal('page-hydrated');
})());
