import { useContext } from 'octane';
import * as stylex from '@octanejs/stylex';
import { LocaleContext, TelemetryContext } from './contexts.ts';
import { getBoot } from './boot.ts';
import { draft$ } from './composer-state.tsrx';
import { Icon } from '../ui/Icon.tsrx';

const styles = stylex.create({
	hero: { display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'flex-end', flex: 1, minHeight: 0, paddingBlockEnd: 'var(--lm-space-24)', overflowY: 'auto' },
	title: { margin: 0, marginBlockEnd: 'var(--lm-space-20)', fontSize: 'var(--lm-font-size-3xl)', lineHeight: 'var(--lm-line-height-3xl)', fontWeight: 'var(--lm-font-weight-regular)', letterSpacing: 'var(--lm-letter-spacing-3xl)' },
	suggestions: { display: 'flex', flexWrap: 'wrap', justifyContent: 'center', gap: 'var(--lm-space-8)', maxWidth: 'var(--lm-thread-max)', marginBlockEnd: 'var(--lm-space-16)' },
	chip: {
		display: 'inline-flex',
		alignItems: 'center',
		gap: 'var(--lm-space-6)',
		height: 36,
		paddingInline: 'var(--lm-space-14)',
		borderWidth: 1,
		borderStyle: 'solid',
		borderColor: 'var(--lm-border-chip)',
		borderRadius: 'var(--lm-radius-full)',
		backgroundColor: { default: 'transparent', ':hover': 'var(--lm-surface-hover-default)' },
		fontSize: 'var(--lm-font-size-sm)',
		color: 'var(--lm-text-secondary)',
	},
	starters: { display: 'grid', gridTemplateColumns: 'repeat(4, minmax(0, 1fr))', gap: 'var(--lm-space-8)', width: 'min(var(--lm-thread-max), 100%)', paddingInline: 'var(--lm-space-24)' },
	starter: {
		display: 'flex',
		flexDirection: 'column',
		alignItems: 'flex-start',
		gap: 'var(--lm-space-4)',
		padding: 'var(--lm-space-12)',
		borderWidth: 1,
		borderStyle: 'solid',
		borderColor: 'var(--lm-border-raised)',
		borderRadius: 'var(--lm-radius-xl)',
		backgroundColor: { default: 'var(--lm-surface-raised-default)', ':hover': 'var(--lm-surface-hover-default)' },
		textAlign: 'start',
	},
	starterTitle: { fontSize: 'var(--lm-font-size-sm)', fontWeight: 'var(--lm-font-weight-medium)' },
	starterText: { fontSize: 'var(--lm-font-size-xs)', color: 'var(--lm-text-tertiary)' },
	hidden: { display: 'none' },
});

function Starter(props) @{
	<button type="button" class={['lm-starter', stylex.props(styles.starter).className]} data-starter={props.starter.id} onClick={props.onPick}>
		<Icon name={props.starter.icon} />
		<span {...stylex.props(styles.starterTitle)}>{props.starter.title}</span>
		<span {...stylex.props(styles.starterText)}>{props.starter.prompt}</span>
	</button>
}

export function Home() @{
	const { strings } = useContext(LocaleContext);
	const telemetry = useContext(TelemetryContext);
	const home = getBoot().home;
	const pick = (text) => {
		telemetry.business('home_suggestion_picked', { length: text.length });
		draft$.set(text);
	};
	<section class={['lm-home-hero lm-thread', stylex.props(styles.hero).className]} data-empty="true" data-streaming="false">
		<h1 {...stylex.props(styles.title)}>{strings.heroTitle}</h1>
		<div class="lm-home-suggestions" {...stylex.props(styles.suggestions)} role="list">
			@for (const text of home.suggestions; index i; key i) {
				<button type="button" role="listitem" {...stylex.props(styles.chip)} data-suggestion={i} onClick={() => pick(text)}>
					<Icon name={['edit', 'globe', 'code', 'sparkle', 'image', 'search'][i % 6]} />
					<span>{text}</span>
				</button>
			}
		</div>
		<div class="lm-starters" {...stylex.props(styles.starters)} aria-label="Starters">
			@for (const starter of home.starters.slice(0, 8); key starter.id) {
				<Starter starter={starter} onPick={() => pick(starter.prompt)} />
			}
		</div>
		<div {...stylex.props(styles.hidden)} data-starters-more="" aria-hidden="true">
			@for (const starter of home.starters.slice(8); key starter.id) {
				<Starter starter={starter} onPick={() => pick(starter.prompt)} />
			}
		</div>
	</section>
}
