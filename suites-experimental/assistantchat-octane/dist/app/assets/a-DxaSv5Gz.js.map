import { useContext } from 'octane';
import * as stylex from '@octanejs/stylex';
import { ThemeContext } from '../app/contexts.ts';
import { Icon } from './Icon.tsrx';

const styles = stylex.create({
	base: {
		display: 'inline-flex',
		alignItems: 'center',
		justifyContent: 'center',
		gap: 'var(--lm-space-6)',
		borderWidth: 0,
		borderStyle: 'solid',
		borderRadius: 'var(--lm-radius-full)',
		fontSize: 'var(--lm-font-size-sm)',
		fontWeight: 'var(--lm-font-weight-medium)',
		lineHeight: 'var(--lm-line-height-sm)',
		whiteSpace: 'nowrap',
		transitionProperty: 'background-color, color, opacity',
		transitionDuration: 'var(--lm-duration-fast)',
		outlineOffset: { default: null, ':focus-visible': 2 },
		outline: { default: null, ':focus-visible': '2px solid var(--lm-accent-teal-ring)' },
		cursor: { default: 'pointer', ':disabled': 'default' },
		opacity: { default: 1, ':disabled': 0.4 },
	},
	md: { height: 36, paddingInline: 'var(--lm-space-14)' },
	sm: { height: 32, paddingInline: 'var(--lm-space-12)' },
	icon: { width: 36, height: 36, paddingInline: 0 },
	iconSm: { width: 32, height: 32, paddingInline: 0, borderRadius: 'var(--lm-radius-md)' },
	primary: {
		backgroundColor: { default: 'var(--lm-text-primary)', ':hover': 'var(--lm-text-secondary)' },
		color: 'var(--lm-surface-canvas-default)',
	},
	secondary: {
		backgroundColor: { default: 'transparent', ':hover': 'var(--lm-surface-hover-default)' },
		color: 'var(--lm-text-primary)',
		borderWidth: 1,
		borderColor: 'var(--lm-border-raised)',
	},
	ghost: {
		backgroundColor: { default: 'transparent', ':hover': 'var(--lm-surface-hover-default)', ':active': 'var(--lm-surface-pressed-default)' },
		color: 'var(--lm-text-secondary)',
	},
	danger: {
		backgroundColor: { default: 'var(--lm-red-600)', ':hover': 'var(--lm-red-700)' },
		color: 'white',
	},
	accent: {
		backgroundColor: { default: 'var(--lm-accent)', ':hover': 'var(--lm-accent-hover)' },
		color: 'var(--lm-text-on-accent)',
	},
	dense: { gap: 'var(--lm-space-4)' },
});

export function Button(props) @{
	const theme = useContext(ThemeContext);
	const variant = props.variant ?? 'ghost';
	const size = props.size ?? 'md';
	const iconOnly = props.icon && !props.label;
	const sx = stylex.props(
		styles.base,
		iconOnly ? (size === 'sm' ? styles.iconSm : styles.icon) : size === 'sm' ? styles.sm : styles.md,
		variant === 'primary' && styles.primary,
		variant === 'secondary' && styles.secondary,
		variant === 'ghost' && styles.ghost,
		variant === 'danger' && styles.danger,
		variant === 'accent' && styles.accent,
		theme.density === 'compact' && styles.dense,
	);
	<button
		type={props.type ?? 'button'}
		class={[sx.className, props.class]}
		aria-label={iconOnly ? props.aria : props.ariaLabel}
		aria-expanded={props.expanded}
		aria-haspopup={props.haspopup}
		aria-pressed={props.pressed}
		data-action={props.action}
		data-state={props.state}
		disabled={props.disabled}
		onClick={props.onClick}
	>
		@if (props.icon) {
			<Icon name={props.icon} />
		}
		@if (props.label) {
			<span>{props.label}</span>
		}
	</button>
}
