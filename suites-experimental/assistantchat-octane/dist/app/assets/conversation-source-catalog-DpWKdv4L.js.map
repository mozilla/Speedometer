// The component catalog of the generated-UI language: it renders a decoded
// revision tree into data-d-* DOM. Every component is memoized and reads the
// contexts it needs (theme, locale, message, streaming state, widget
// registry, layout), as a design-system-built catalog does.
import { createContext, memo, useContext, useLayoutEffect, useMemo, useRef, useState } from 'octane';
import * as stylex from '@octanejs/stylex';
import { LayoutContext, LocaleContext, MessageContext, StreamingContext, ThemeContext, WidgetContext } from '../app/contexts.ts';
import { env } from '../app/env.ts';
import { highlight } from '../highlight/shiki.ts';
import { Button } from '../ui/Button.tsrx';
import { splitWords } from './words.ts';
import { highlightSettled, highlightStarted } from '../conversation/completion.ts';

const styles = stylex.create({
	heading: { marginBlock: 'var(--lm-space-20) var(--lm-space-8)', fontWeight: 'var(--lm-font-weight-semibold)', color: 'var(--lm-text-heading)' },
	h1: { fontSize: 'var(--lm-font-size-2xl)', lineHeight: 'var(--lm-line-height-2xl)', letterSpacing: 'var(--lm-letter-spacing-2xl)' },
	h2: { fontSize: 'var(--lm-font-size-xl)', lineHeight: 'var(--lm-line-height-xl)' },
	h3: { fontSize: 'var(--lm-font-size-lg)', lineHeight: 'var(--lm-line-height-lg)' },
	para: { marginBlock: 'var(--lm-space-8)', lineHeight: 1.7 },
	strong: { fontWeight: 'var(--lm-font-weight-semibold)', color: 'var(--lm-text-primary)' },
	inlineCode: {
		fontFamily: 'var(--lm-font-mono)',
		fontSize: '0.875em',
		paddingInline: 'var(--lm-space-4)',
		paddingBlock: 1,
		borderRadius: 'var(--lm-radius-xs)',
		backgroundColor: 'var(--lm-surface-code-muted)',
	},
	link: { color: 'var(--lm-text-link)', textDecoration: { default: 'underline', ':hover': 'none' }, textUnderlineOffset: 2 },
	badge: {
		display: 'inline-block',
		paddingInline: 'var(--lm-space-6)',
		borderRadius: 'var(--lm-radius-full)',
		fontSize: 'var(--lm-font-size-xs)',
		fontWeight: 'var(--lm-font-weight-medium)',
		backgroundColor: 'var(--lm-accent-soft)',
		color: 'var(--lm-accent-text)',
		verticalAlign: 'middle',
	},
	list: { marginBlock: 'var(--lm-space-8)', paddingInlineStart: 'var(--lm-space-24)', display: 'flex', flexDirection: 'column', gap: 'var(--lm-list-gap, var(--lm-space-4))' },
	item: { lineHeight: 1.7, paddingInlineStart: 'var(--lm-space-4)' },
	quote: { marginBlock: 'var(--lm-space-12)', marginInline: 0, paddingInlineStart: 'var(--lm-space-16)', borderInlineStartWidth: 3, borderInlineStartStyle: 'solid', borderInlineStartColor: 'var(--lm-border-raised)', color: 'var(--lm-text-secondary)' },
	rule: { marginBlock: 'var(--lm-space-24)', borderWidth: 0, borderTopWidth: 1, borderTopStyle: 'solid', borderTopColor: 'var(--lm-border-canvas)' },
	callout: { display: 'flex', gap: 'var(--lm-space-8)', marginBlock: 'var(--lm-space-12)', padding: 'var(--lm-space-12)', borderRadius: 'var(--lm-radius-lg)' },
	info: { backgroundColor: 'var(--lm-accent-sky-soft)', color: 'var(--lm-accent-sky-text)' },
	warn: { backgroundColor: 'var(--lm-accent-amber-soft)', color: 'var(--lm-accent-amber-text)' },
	tableViewport: { position: 'relative', marginBlock: 'var(--lm-space-12)', overflowX: 'auto', borderRadius: 'var(--lm-radius-lg)', borderWidth: 1, borderStyle: 'solid', borderColor: 'var(--lm-border-table-row)' },
	table: { width: '100%', borderCollapse: 'collapse', fontSize: 'var(--lm-font-size-md)' },
	cell: { paddingBlock: 'var(--lm-space-8)', paddingInline: 'var(--lm-space-12)', textAlign: 'start', verticalAlign: 'top', borderBottomWidth: 1, borderBottomStyle: 'solid', borderBottomColor: 'var(--lm-border-table-row)' },
	headCell: { fontWeight: 'var(--lm-font-weight-semibold)', backgroundColor: 'var(--lm-surface-table-head-default)' },
	word: {
		animationName: stylex.keyframes({ from: { opacity: 0 }, to: { opacity: 1 } }),
		animationDuration: 'var(--lm-duration-word)',
		animationFillMode: 'both',
	},
	code: { marginBlock: 'var(--lm-space-12)', borderRadius: 'var(--lm-radius-xl)', overflow: 'hidden', backgroundColor: 'var(--lm-surface-code-default)', borderWidth: 1, borderStyle: 'solid', borderColor: 'var(--lm-border-code)' },
	codeHeader: { position: 'sticky', top: 0, display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingInline: 'var(--lm-space-12)', height: 36, fontSize: 'var(--lm-font-size-xs)', color: 'var(--lm-code-header-text, var(--lm-text-tertiary))', backgroundColor: 'var(--lm-surface-code-muted)' },
	pre: { margin: 0, padding: 'var(--lm-space-16)', overflowX: 'auto', fontFamily: 'var(--lm-font-mono)', fontSize: 'var(--lm-font-size-sm)', lineHeight: 1.6, tabSize: 4 },
	codeText: { color: 'var(--lm-code-text, var(--lm-text-code))' },
});

// The catalog's own scopes: typography, density, writing direction and
// citations, provided once per reply.
const TypographyContext = createContext({ scale: 'reading', tracking: 'normal' });
const DensityContext = createContext('comfortable');
const DirectionContext = createContext('ltr');
const CitationContext = createContext(null);

const WORD_CLASS = stylex.props(styles.word).className;

// Streamed words are spans. The words of the latest revision carry the
// fade-in; the spans stay when it ends.
function Text(props) @{
	const streaming = useContext(StreamingContext);
	const typography = useContext(TypographyContext);
	const node = props.node;
	const fresh = streaming.streaming ? streaming.seenWords - node.start : node.count;
	@for (const word of splitWords(node.text); index i; key i) {
		<span data-streaming-word={i >= fresh ? '' : undefined} class={i >= fresh ? WORD_CLASS : undefined} data-d-tracking={typography.tracking}>{word}</span>
	}
}

// Design-system parts: a block frame around every block-level component and
// a typographic part inside every component. They add no styling of their
// own beyond attributes, but read the scopes they depend on.
const Part = memo(function Part(props) @{
	const theme = useContext(ThemeContext);
	const layout = useContext(LayoutContext);
	const typography = useContext(TypographyContext);
	const direction = useContext(DirectionContext);
	<>{props.children}</>
});

const Block = memo(function Block(props) @{
	const message = useContext(MessageContext);
	const density = useContext(DensityContext);
	const citations = useContext(CitationContext);
	<div class="lm-block" data-d-block={props.kind} data-d-density={density} data-msg={message.id} data-d-cited={citations ? 'true' : undefined}>
		<Part kind={props.kind}>{props.children}</Part>
	</div>
});

function Children(props) @{
	@for (const child of props.nodes; index i; key i) {
		<Node node={child} />
	}
}

const Heading = memo(function Heading(props) @{
	const theme = useContext(ThemeContext);
	const message = useContext(MessageContext);
	const level = props.node.props.level ?? 2;
	const sx = stylex.props(styles.heading, level === 1 ? styles.h1 : level === 2 ? styles.h2 : styles.h3);
	@switch (level) {
		@case 1: {
			<Block kind="heading"><h2 class={['lm-heading', sx.className]} data-d-component="heading" data-theme-accent={theme.accent} data-msg={message.id}><Children nodes={props.node.children} /></h2></Block>
		}
		@case 2: {
			<Block kind="heading"><h3 class={['lm-heading', sx.className]} data-d-component="heading" data-theme-accent={theme.accent} data-msg={message.id}><Children nodes={props.node.children} /></h3></Block>
		}
		@default: {
			<Block kind="heading"><h4 class={['lm-heading', sx.className]} data-d-component="heading" data-theme-accent={theme.accent} data-msg={message.id}><Children nodes={props.node.children} /></h4></Block>
		}
	}
});

const Para = memo(function Para(props) @{
	const locale = useContext(LocaleContext);
	const message = useContext(MessageContext);
	<Block kind="text"><p class={['lm-para', stylex.props(styles.para).className]} data-d-component="text" lang={locale.locale} data-role={message.role}><Children nodes={props.node.children} /></p></Block>
});

const Strong = memo(function Strong(props) @{
	const theme = useContext(ThemeContext);
	<strong {...stylex.props(styles.strong)} data-d-component="bold" data-density={theme.density}><Part kind="bold"><Children nodes={props.node.children} /></Part></strong>
});

const Em = memo(function Em(props) @{
	const theme = useContext(ThemeContext);
	<em data-d-component="italic" data-density={theme.density}><Part kind="italic"><Children nodes={props.node.children} /></Part></em>
});

const InlineCode = memo(function InlineCode(props) @{
	const theme = useContext(ThemeContext);
	const streaming = useContext(StreamingContext);
	<code {...stylex.props(styles.inlineCode)} data-d-component="inline-code" data-theme={theme.theme} data-pending={streaming.streaming ? 'true' : undefined}><Part kind="inline-code"><Children nodes={props.node.children} /></Part></code>
});

const Link = memo(function Link(props) @{
	const locale = useContext(LocaleContext);
	const message = useContext(MessageContext);
	<a {...stylex.props(styles.link)} href={props.node.props.href} target="_blank" rel="noopener" data-d-component="link" hreflang={locale.locale} data-msg={message.id} onClick={(event) => event.preventDefault()}><Part kind="link"><Children nodes={props.node.children} /></Part></a>
});

const Badge = memo(function Badge(props) @{
	const theme = useContext(ThemeContext);
	<span class={['lm-badge', stylex.props(styles.badge).className]} data-d-component="badge" data-accent={theme.accent}><Part kind="badge"><Children nodes={props.node.children} /></Part></span>
});

const List = memo(function List(props) @{
	const message = useContext(MessageContext);
	const layout = useContext(LayoutContext);
	const sx = stylex.props(styles.list);
	@if (props.node.props.ordered) {
		<Block kind="list"><ol class={['lm-list', sx.className]} data-d-component="list" data-d-marker="decimal" data-d-marker-layout={layout.compact ? 'inside' : 'outside'} data-msg={message.id}><Children nodes={props.node.children} /></ol></Block>
	} @else {
		<Block kind="list"><ul class={['lm-list', sx.className]} data-d-component="list" data-d-marker="disc" data-d-marker-layout={layout.compact ? 'inside' : 'outside'} data-msg={message.id}><Children nodes={props.node.children} /></ul></Block>
	}
});

const Item = memo(function Item(props) @{
	const theme = useContext(ThemeContext);
	<li class={['lm-list-item', stylex.props(styles.item).className]} data-d-component="list-item" data-density={theme.density}><Part kind="item"><Children nodes={props.node.children} /></Part></li>
});

const Quote = memo(function Quote(props) @{
	const locale = useContext(LocaleContext);
	<Block kind="quote"><blockquote class={['lm-quote', stylex.props(styles.quote).className]} data-d-component="quote" lang={locale.locale}><Children nodes={props.node.children} /></blockquote></Block>
});

const Rule = memo(function Rule() @{
	const theme = useContext(ThemeContext);
	<Block kind="rule"><hr {...stylex.props(styles.rule)} data-d-component="rule" data-theme={theme.theme} /></Block>
});

const Callout = memo(function Callout(props) @{
	const theme = useContext(ThemeContext);
	const tone = props.node.props.tone ?? 'info';
	<Block kind="callout"><div class={['lm-callout', stylex.props(styles.callout, tone === 'warn' ? styles.warn : styles.info).className]} role="note" data-d-component="callout" data-tone={tone} data-theme={theme.theme}><span aria-hidden="true">{tone === 'warn' ? '!' : 'i'}</span><div><Children nodes={props.node.children} /></div></div></Block>
});

// Tables measure their overflow after every render and mark the edges that
// have hidden content, which the stylesheet fades out.
const Table = memo(function Table(props) @{
	const layout = useContext(LayoutContext);
	const message = useContext(MessageContext);
	const viewport = useRef(null);
	const [edges, setEdges] = useState('');
	useLayoutEffect(() => {
		const el = viewport.current;
		const overflow = el.scrollWidth - el.clientWidth;
		const start = el.scrollLeft > 0;
		const end = overflow - el.scrollLeft > 1;
		const next = [start && 'start', end && 'end'].filter(Boolean).join(' ');
		if (next !== edges)
			setEdges(next);
	}, [props.node, layout.width]);
	<Block kind="table"><div class={['lm-table-viewport', stylex.props(styles.tableViewport).className]} ref={viewport} data-d-table-viewport="" data-width={layout.width} data-msg={message.id}>
		<table {...stylex.props(styles.table)} data-d-component="table" data-d-table-overflow-edges={edges}>
			<thead>
				<tr>
					@for (const column of props.node.props.columns; index i; key i) {
						<th {...stylex.props(styles.cell, styles.headCell)} data-d-component="table-cell" scope="col">{typeof column === 'string' ? column : column.text}</th>
					}
				</tr>
			</thead>
			<tbody><Children nodes={props.node.children} /></tbody>
		</table>
	</div></Block>
});

const Row = memo(function Row(props) @{
	const theme = useContext(ThemeContext);
	<tr data-d-component="table-row" data-density={theme.density}><Part kind="row"><Children nodes={props.node.children} /></Part></tr>
});

const Cell = memo(function Cell(props) @{
	const theme = useContext(ThemeContext);
	<td {...stylex.props(styles.cell)} data-d-component="table-cell" data-density={theme.density}><Part kind="cell"><Children nodes={props.node.children} /></Part></td>
});

const highlighted = new Map();

function escapeHTML(text) {
	return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// Code blocks re-highlight whenever their source grows and once more when
// they are complete; the header's copy button serializes the source.
const CodeBlock = memo(function CodeBlock(props) @{
	const theme = useContext(ThemeContext);
	const { strings } = useContext(LocaleContext);
	const widgets = useContext(WidgetContext);
	const message = useContext(MessageContext);
	const { id, lang, source, complete } = props.node.props;
	const key = `${theme.theme}:${lang}:${source}`;
	const [html, setHtml] = useState(() => highlighted.get(key) ?? null);
	const [copied, setCopied] = useState(false);
	const header = useRef(null);
	// The highlight whose commit the reply's completion waits for.
	const committing = useRef(null);
	useLayoutEffect(() => {
		const cached = highlighted.get(key);
		if (cached) {
			setHtml(cached);
			return;
		}
		let live = true;
		highlightStarted();
		highlight(source, lang, theme.theme === 'dark' ? 'dark' : 'light').then((result) => {
			highlighted.set(key, result.html);
			if (live && result.html !== html) {
				committing.current = result.html;
				setHtml(result.html);
			} else {
				highlightSettled();
			}
		});
		return () => {
			live = false;
		};
	}, [key, complete]);
	useLayoutEffect(() => {
		if (committing.current !== null && committing.current === html) {
			committing.current = null;
			highlightSettled();
		}
	}, [html]);
	useLayoutEffect(() => {
		widgets?.measure(id, header.current.getBoundingClientRect().height);
	}, [props.node]);
	const copy = () => {
		widgets?.copyCode(source, lang);
		setCopied(true);
		env.onFlush(() => setCopied(false));
	};
	<Block kind="code"><div class={['lm-code-block', stylex.props(styles.code).className]} data-d-component="code-block" data-widget={id} data-lang={lang} data-complete={complete ? 'true' : 'false'} data-msg={message.id}>
		<div ref={header} {...stylex.props(styles.codeHeader)}>
			<span>{lang}</span>
			<Button class="lm-code-copy" size="sm" icon={copied ? 'check' : 'copy'} label={copied ? strings.copied : strings.copyCode} action="copy-code" state={copied ? 'copied' : 'idle'} onClick={copy} />
		</div>
		<pre {...stylex.props(styles.pre)}>
			<code class={['lm-code', stylex.props(styles.codeText).className]} data-highlighted={html ? 'true' : 'false'} dangerouslySetInnerHTML={{ __html: html ?? escapeHTML(source) }} />
		</pre>
	</div></Block>
});

const CATALOG = {
	heading: Heading,
	para: Para,
	strong: Strong,
	em: Em,
	'inline-code': InlineCode,
	link: Link,
	badge: Badge,
	list: List,
	item: Item,
	quote: Quote,
	rule: Rule,
	callout: Callout,
	table: Table,
	row: Row,
	cell: Cell,
	widget: CodeBlock,
};

// Every component renders inside a memoized presentation boundary, which
// resolves it from the catalog.
const Boundary = memo(function Boundary(props) @{
	const theme = useContext(ThemeContext);
	const message = useContext(MessageContext);
	const Component = CATALOG[props.node.type];
	<Component node={props.node} />
});

function Node(props) @{
	const node = props.node;
	@if (node.type === '#text') {
		<Text node={node} />
	} @else {
		<Boundary node={node} />
	}
}

export function ReplyContent(props) @{
	const typography = useMemo(() => ({ scale: 'reading', tracking: 'normal' }), []);
	<TypographyContext value={typography}>
		<DensityContext value="comfortable">
			<DirectionContext value="ltr">
				<CitationContext value={null}>
					<div class="lm-reply" data-d-root="" data-revision={props.tree.revision}><Children nodes={props.tree.children} /></div>
				</CitationContext>
			</DirectionContext>
		</DensityContext>
	</TypographyContext>
}
