import { useContext, useState } from 'octane';
import * as stylex from '@octanejs/stylex';
import { LocaleContext, TelemetryContext } from '../app/contexts.ts';
import { env } from '../app/env.ts';
import { Button } from '../ui/Button.tsrx';
import { Sheet } from '../ui/Sheet.tsrx';

const styles = stylex.create({
	row: { display: 'flex', alignItems: 'center', gap: 'var(--lm-space-2)', marginBlockStart: 'var(--lm-space-4)', marginInlineStart: 'calc(-1 * var(--lm-space-8))', opacity: 'var(--lm-actions-opacity, 1)' },
	field: { display: 'flex', gap: 'var(--lm-space-8)', alignItems: 'center', padding: 'var(--lm-space-6)', borderWidth: 1, borderStyle: 'solid', borderColor: 'var(--lm-border-raised)', borderRadius: 'var(--lm-radius-full)' },
	input: { flex: 1, borderWidth: 0, backgroundColor: 'transparent', paddingInline: 'var(--lm-space-10)', color: 'var(--lm-text-secondary)' },
	hint: { color: 'var(--lm-text-secondary)', fontSize: 'var(--lm-font-size-sm)' },
});

export function ActionRow(props) @{
	const { strings } = useContext(LocaleContext);
	const telemetry = useContext(TelemetryContext);
	const [copied, setCopied] = useState(false);
	const [feedback, setFeedback] = useState(null);
	const [sharing, setSharing] = useState(false);
	const copy = () => {
		props.onCopy();
		setCopied(true);
		env.onFlush(() => setCopied(false));
	};
	const rate = (value) => {
		setFeedback(value);
		telemetry.business('message_feedback', { value, message: props.reply.messageId });
	};
	<div class={['lm-action-row', stylex.props(styles.row).className]} role="group" aria-label="Response actions">
		<Button size="sm" icon={copied ? 'check' : 'copy'} aria={copied ? strings.copied : strings.copy} action="copy-reply" state={copied ? 'copied' : 'idle'} onClick={copy} />
		<Button size="sm" icon="thumb-up" aria={strings.goodResponse} action="thumb-up" pressed={feedback === 'up' ? 'true' : 'false'} onClick={() => rate('up')} />
		<Button size="sm" icon="thumb-down" aria={strings.badResponse} action="thumb-down" pressed={feedback === 'down' ? 'true' : 'false'} onClick={() => rate('down')} />
		<Button size="sm" icon="speaker" aria={strings.readAloud} action="read-aloud" />
		<Button size="sm" icon="share" aria={strings.share} action="share-reply" onClick={() => {
			telemetry.business('share_opened', { message: props.reply.messageId });
			setSharing(true);
		}} />
		<Button size="sm" icon="refresh" aria={strings.regenerate} action="regenerate" />
		<Button size="sm" icon="more" aria={strings.more} action="more" haspopup="menu" />
		@if (sharing) {
			<Sheet id="share" title={strings.shareTitle} onClose={() => setSharing(false)}>
				<p {...stylex.props(styles.hint)}>{strings.shareBody}</p>
				<div {...stylex.props(styles.field)}>
					<input {...stylex.props(styles.input)} readOnly value={'https://lumen.example/share/' + props.reply.messageId} aria-label="Share link" />
					<Button variant="primary" icon="link" label={strings.createLink} action="create-link" onClick={() => telemetry.business('share_link_created', {})} />
				</div>
			</Sheet>
		}
	</div>
}
