import { useLayoutEffect, useState } from 'octane';
import { conversation } from './store.ts';

// Subscribes during the commit, in a layout effect. Octane's
// useSyncExternalStore subscribes after the next paint, and a reply stream
// that starts before then would update a store nobody listens to yet.
export function useConversation() {
	const [state, setState] = useState(conversation.getSnapshot);
	useLayoutEffect(() => {
		const update = () => setState(conversation.getSnapshot());
		update();
		return conversation.subscribe(update);
	}, []);
	return state;
}
