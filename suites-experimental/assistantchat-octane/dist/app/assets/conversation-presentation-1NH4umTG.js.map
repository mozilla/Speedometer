import { useContext, useLayoutEffect, useRef, useState } from 'octane';
import * as stylex from '@octanejs/stylex';
import { LocaleContext, TelemetryContext } from '../app/contexts.ts';
import { env } from '../app/env.ts';
import { useConversation } from './use-conversation.tsrx';
import { UserTurn } from './UserTurn.tsrx';
import { AssistantTurn } from './AssistantTurn.tsrx';
import { SponsoredUnit } from '../ads/SponsoredUnit.tsrx';
import { Button } from '../ui/Button.tsrx';

const BOTTOM_THRESHOLD = 96;

const styles = stylex.create({
	scroller: { position: 'relative', flex: 1, minHeight: 0, overflowY: 'auto', overflowAnchor: 'none' },
	column: { maxWidth: 'var(--lm-thread-max)', marginInline: 'auto', paddingInline: 'var(--lm-space-24)', paddingBlock: 'var(--lm-space-24)' },
	scrollBottom: { position: 'sticky', bottom: 'var(--lm-space-12)', display: 'flex', justifyContent: 'center', pointerEvents: 'none' },
	scrollButton: { pointerEvents: 'auto', boxShadow: 'var(--lm-shadow-3)', backgroundColor: 'var(--lm-surface-raised-default)' },
	slot: { display: 'block' },
	suggestions: { display: 'flex', flexWrap: 'wrap', gap: 'var(--lm-space-8)', marginBlock: 'var(--lm-space-8)' },
});

// The transcript. After every change it measures where the reader is: if
// they were at the bottom it keeps them there, otherwise it shows the
// scroll-to-bottom button. The thresholds come from computed styles.
export function Thread() @{
	const { strings } = useContext(LocaleContext);
	const telemetry = useContext(TelemetryContext);
	const state = useConversation();
	const scroller = useRef(null);
	const pinned = useRef(true);
	const written = useRef(-1);
	const [away, setAway] = useState(false);
	useLayoutEffect(() => {
		telemetry.pageView(env.route());
		env.signal('route-ready', 'thread');
	}, []);
	useLayoutEffect(() => {
		const el = scroller.current;
		const style = getComputedStyle(el.closest('.lm-main') ?? el.ownerDocument.documentElement);
		const composer = parseFloat(style.getPropertyValue('--lm-composer-height')) || 52;
		if (pinned.current) {
			el.scrollTop = el.scrollHeight;
			written.current = el.scrollTop;
		}
		const distance = el.scrollHeight - el.scrollTop - el.clientHeight;
		const next = distance > BOTTOM_THRESHOLD + composer / 4;
		if (next !== away)
			setAway(next);
	}, [state]);
	// Scroll events from our own writes arrive a task later, when the reply
	// may have grown again; only the reader's scrolling unpins.
	const onScroll = () => {
		const el = scroller.current;
		if (Math.abs(el.scrollTop - written.current) < 2)
			return;
		pinned.current = el.scrollHeight - el.scrollTop - el.clientHeight < BOTTOM_THRESHOLD;
	};
	const last = state.turns.length - 1;
	<div class={['lm-scroll', stylex.props(styles.scroller).className]} ref={scroller} onScroll={onScroll}>
		<div class={['lm-thread lm-thread-column', stylex.props(styles.column).className]} data-empty={state.turns.length ? 'false' : 'true'} data-streaming={state.streaming ? 'true' : 'false'} data-thread={state.threadId}>
			@for (const turn of state.turns; index i; key turn.id) {
				<>
					<UserTurn turn={turn} index={i} />
					<AssistantTurn turn={turn} index={i} last={i === last} />
					@if (i === 0 && turn.reply.status === 'done') {
						<SponsoredUnit index={i} />
					}
				</>
			}
			<div class={['lm-suggestions', stylex.props(styles.suggestions).className]} dangerouslySetInnerHTML={{ __html: '<?marker name="suggestions">' }} />
			<div class={['lm-slot', stylex.props(styles.slot).className]} data-slot="reply-actions" dangerouslySetInnerHTML={{ __html: '<?start name="reply-actions"><?end>' }} />
			<div class={['lm-slot', stylex.props(styles.slot).className]} data-slot="signin-nudge" dangerouslySetInnerHTML={{ __html: '<?start name="signin-nudge"><?end>' }} />
			<div class={['lm-slot', stylex.props(styles.slot).className]} data-slot="safety-notice" dangerouslySetInnerHTML={{ __html: '<?start name="safety-notice"><?end>' }} />
		</div>
		@if (away) {
			<div class={['lm-scroll-bottom', stylex.props(styles.scrollBottom).className]}>
				<Button class={stylex.props(styles.scrollButton).className} icon="arrow-down" aria={strings.scrollToBottom} variant="secondary" action="scroll-bottom" onClick={() => {
					pinned.current = true;
					scroller.current.scrollTop = scroller.current.scrollHeight;
				}} />
			</div>
		}
	</div>
}
