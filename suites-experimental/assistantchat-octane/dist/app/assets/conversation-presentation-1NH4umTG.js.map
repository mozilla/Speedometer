import { memo, useContext, useLayoutEffect, useMemo, useRef, useState } from 'octane';
import * as stylex from '@octanejs/stylex';
import { LocaleContext, MessageContext, StreamingContext, TelemetryContext, WidgetContext } from '../app/contexts.ts';
import { ReplyContent } from '../genui/Catalog.tsrx';
import { ActionRow } from './ActionRow.tsrx';
import { copyMessage } from './copy.ts';
import { streamFinished } from './completion.ts';

const styles = stylex.create({
	turn: { position: 'relative', marginBlock: 'var(--lm-space-16)', paddingInlineEnd: 'var(--lm-space-8)', minHeight: 32 },
	thinking: {
		display: 'inline-block',
		color: 'var(--lm-text-tertiary)',
		backgroundImage: 'linear-gradient(90deg, currentColor 40%, var(--lm-text-quaternary) 50%, currentColor 60%)',
		backgroundSize: '200% 100%',
		backgroundClip: 'text',
		WebkitTextFillColor: 'transparent',
		animationName: stylex.keyframes({ from: { backgroundPosition: '100% 0' }, to: { backgroundPosition: '-100% 0' } }),
		animationDuration: '1.6s',
		animationIterationCount: 'infinite',
	},
});

export const AssistantTurn = memo(function AssistantTurn(props) @{
	const { strings } = useContext(LocaleContext);
	const telemetry = useContext(TelemetryContext);
	const reply = props.turn.reply;
	const article = useRef(null);
	const headers = useRef(new Map());
	const message = useMemo(() => ({ id: reply.messageId || props.turn.id, role: 'assistant', status: reply.status, turn: props.index }), [reply.messageId, reply.status]);
	const streaming = useMemo(() => ({ streaming: reply.status !== 'done' || reply.seenWords < reply.words, revision: reply.seq, seenWords: reply.seenWords }), [reply.seq, reply.status, reply.seenWords]);
	const widgets = useMemo(() => ({
		measure(id, height) {
			headers.current.set(id, height);
		},
		copyCode(source, lang) {
			telemetry.business('code_copied', { lang, lines: source.split('\n').length, message: reply.messageId });
			navigator.clipboard.writeText(source);
		},
	}), [reply.messageId]);
	// The commit of the final state: the code blocks' layout effects, which
	// start the last highlights, have run before this one. A transcript that
	// mounts with finished replies (back from settings) doesn't announce them.
	const streamed = useRef(reply.status !== 'done');
	useLayoutEffect(() => {
		if (reply.status === 'done' && streamed.current) {
			streamed.current = false;
			streamFinished();
		}
	}, [reply.status]);
	<article ref={article} class={['lm-msg lm-msg-assistant', stylex.props(styles.turn).className]} data-turn={props.index} data-role="assistant" data-status={reply.status} data-message-id={reply.messageId}>
		<h6 class="lm-sr-only">{strings.assistant}</h6>
		<MessageContext value={message}>
			<StreamingContext value={streaming}>
				<WidgetContext value={widgets}>
					@if (reply.tree) {
						<ReplyContent tree={reply.tree} />
					} @else {
						<span {...stylex.props(styles.thinking)}>{strings.thinking}</span>
					}
				</WidgetContext>
			</StreamingContext>
		</MessageContext>
		@if (reply.status === 'done') {
			<ActionRow reply={reply} onCopy={() => copyMessage(article.current, reply, telemetry)} />
		}
	</article>
});
