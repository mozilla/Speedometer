import { memo, useContext } from 'octane';
import * as stylex from '@octanejs/stylex';
import { LocaleContext, ThemeContext } from '../app/contexts.ts';

const styles = stylex.create({
	turn: { display: 'flex', justifyContent: 'flex-end', marginBlock: 'var(--lm-space-16)' },
	bubble: {
		maxWidth: 'var(--lm-bubble-max)',
		paddingBlock: 'var(--lm-space-10)',
		paddingInline: 'var(--lm-space-16)',
		borderRadius: 'var(--lm-radius-3xl)',
		backgroundColor: 'var(--lm-surface-bubble-default)',
		whiteSpace: 'pre-wrap',
		overflowWrap: 'anywhere',
	},
});

export const UserTurn = memo(function UserTurn(props) @{
	const { strings } = useContext(LocaleContext);
	const theme = useContext(ThemeContext);
	<article class={['lm-msg lm-msg-user', stylex.props(styles.turn).className]} data-turn={props.index} data-role="user" data-theme={theme.theme}>
		<h5 class="lm-sr-only">{strings.you}</h5>
		<div class={['lm-bubble', stylex.props(styles.bubble).className]}>{props.turn.prompt}</div>
	</article>
});
