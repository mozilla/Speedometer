import * as stylex from '@octanejs/stylex';

const styles = stylex.create({
	track: {
		position: 'relative',
		width: 36,
		height: 20,
		flex: 'none',
		padding: 0,
		borderWidth: 0,
		borderRadius: 'var(--lm-radius-full)',
		backgroundColor: 'var(--lm-surface-sunken-strong)',
		transitionProperty: 'background-color',
		transitionDuration: 'var(--lm-duration-fast)',
	},
	on: { backgroundColor: 'var(--lm-accent)' },
	thumb: {
		position: 'absolute',
		top: 2,
		left: 2,
		width: 16,
		height: 16,
		borderRadius: 'var(--lm-radius-full)',
		backgroundColor: 'white',
		boxShadow: 'var(--lm-shadow-1)',
		transitionProperty: 'transform',
		transitionDuration: 'var(--lm-duration-fast)',
	},
	thumbOn: { transform: 'translateX(16px)' },
});

export function Switch(props) @{
	<button
		type="button"
		role="switch"
		class={['lm-switch', stylex.props(styles.track, props.checked && styles.on).className]}
		aria-checked={props.checked ? 'true' : 'false'}
		aria-label={props.label}
		data-setting={props.name}
		onClick={() => props.onChange(!props.checked)}
	>
		<span {...stylex.props(styles.thumb, props.checked && styles.thumbOn)} />
	</button>
}
