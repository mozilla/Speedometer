import { useContext, useLayoutEffect, useState } from 'octane';
import { useNavigate } from '@octanejs/tanstack-router';
import * as stylex from '@octanejs/stylex';
import { ActionsContext, GatesContext, LocaleContext, TelemetryContext, ThemeContext } from '../app/contexts.ts';
import { env } from '../app/env.ts';
import { Button } from '../ui/Button.tsrx';
import { Icon } from '../ui/Icon.tsrx';
import { Switch } from '../ui/Switch.tsrx';
import { conversation } from '../conversation/store.ts';

const styles = stylex.create({
	page: { flex: 1, overflowY: 'auto', paddingBlock: 'var(--lm-space-24)', paddingInline: 'var(--lm-space-24)' },
	inner: { display: 'grid', gridTemplateColumns: '200px 1fr', gap: 'var(--lm-space-32)', maxWidth: 880, marginInline: 'auto' },
	title: { display: 'flex', alignItems: 'center', gap: 'var(--lm-space-8)', gridColumn: '1 / -1', margin: 0, fontSize: 'var(--lm-font-size-2xl)', fontWeight: 'var(--lm-font-weight-semibold)' },
	tabs: { display: 'flex', flexDirection: 'column', gap: 'var(--lm-space-2)' },
	tab: { display: 'flex', alignItems: 'center', gap: 'var(--lm-space-8)', height: 36, paddingInline: 'var(--lm-space-10)', borderWidth: 0, borderRadius: 'var(--lm-radius-lg)', backgroundColor: { default: 'transparent', ':hover': 'var(--lm-surface-hover-default)' }, textAlign: 'start', fontSize: 'var(--lm-font-size-md)' },
	tabActive: { backgroundColor: 'var(--lm-surface-selected-default)', fontWeight: 'var(--lm-font-weight-medium)' },
	panel: { display: 'flex', flexDirection: 'column' },
	row: { display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 'var(--lm-space-16)', paddingBlock: 'var(--lm-space-14)', borderBottomWidth: 1, borderBottomStyle: 'solid', borderBottomColor: 'var(--lm-border-canvas)' },
	label: { display: 'flex', flexDirection: 'column', gap: 'var(--lm-space-2)' },
	hint: { fontSize: 'var(--lm-font-size-sm)', color: 'var(--lm-text-secondary)' },
	select: { height: 32, paddingInline: 'var(--lm-space-8)', borderWidth: 1, borderStyle: 'solid', borderColor: 'var(--lm-border-raised)', borderRadius: 'var(--lm-radius-md)', backgroundColor: 'var(--lm-surface-raised-default)' },
});

const TABS = ['general', 'personalization', 'dataControls', 'security'];
const LANGUAGES = ['Auto-detect', 'English', 'Deutsch', 'Español', 'Français', 'Italiano', 'Nederlands', 'Polski', 'Português', 'Svenska', 'Türkçe', '日本語', '한국어', '中文'];

function SelectRow(props) @{
	<div class={['lm-settings-row', stylex.props(styles.row).className]}>
		<label {...stylex.props(styles.label)} for={'setting-' + props.name}>
			<span>{props.label}</span>
		</label>
		<select id={'setting-' + props.name} {...stylex.props(styles.select)} value={props.value} data-setting={props.name} onChange={(event) => props.onChange(event.currentTarget.value)}>
			@for (const option of props.options; key option.value) {
				<option value={option.value}>{option.label}</option>
			}
		</select>
	</div>
}

function SwitchRow(props) @{
	<div class={['lm-settings-row', stylex.props(styles.row).className]}>
		<div {...stylex.props(styles.label)}>
			<span>{props.label}</span>
			@if (props.hint) {
				<span {...stylex.props(styles.hint)}>{props.hint}</span>
			}
		</div>
		<Switch name={props.name} label={props.label} checked={props.checked} onChange={props.onChange} />
	</div>
}

export function Settings() @{
	const { strings } = useContext(LocaleContext);
	const theme = useContext(ThemeContext);
	const actions = useContext(ActionsContext);
	const telemetry = useContext(TelemetryContext);
	const gates = useContext(GatesContext);
	const navigate = useNavigate();
	const [tab, setTab] = useState('general');
	const settings = actions.settings;
	useLayoutEffect(() => {
		telemetry.pageView(env.route());
		env.signal('route-ready', 'settings');
	}, []);
	const showAds = gates.checkGate('settings_ads_controls');
	// Back returns to the open conversation, or home. It doesn't use
	// history.back(): in Speedometer's frame the joint session history keeps
	// entries of earlier suites' frames, and Safari's traversals from a frame
	// can land on them and navigate the frame or the runner away.
	const back = () => {
		const threadId = conversation.getSnapshot().threadId;
		if (threadId)
			navigate({ to: '/c/$threadId', params: { threadId } });
		else
			navigate({ to: '/' });
	};
	<div class={['lm-settings', stylex.props(styles.page).className]}>
		<div {...stylex.props(styles.inner)}>
			<h1 {...stylex.props(styles.title)}>
				<Button icon="arrow-left" aria={strings.back} action="settings-back" onClick={back} />
				<span>{strings.settingsTitle}</span>
			</h1>
			<div {...stylex.props(styles.tabs)} role="tablist" aria-orientation="vertical">
				@for (const id of TABS; key id) {
					<button type="button" role="tab" aria-selected={tab === id ? 'true' : 'false'} {...stylex.props(styles.tab, tab === id && styles.tabActive)} data-tab={id} onClick={() => setTab(id)}>
						<Icon name={id === 'general' ? 'settings' : id === 'personalization' ? 'user' : id === 'dataControls' ? 'archive' : 'pin'} />
						<span>{strings[id]}</span>
					</button>
				}
			</div>
			<div {...stylex.props(styles.panel)} role="tabpanel">
				@if (tab === 'general') {
					<>
					<SelectRow name="theme" label={strings.theme} value={theme.theme} options={[{ value: 'light', label: strings.themeLight }, { value: 'dark', label: strings.themeDark }]} onChange={actions.setTheme} />
					<SelectRow name="accent" label={strings.accent} value={theme.accent} options={['teal', 'indigo', 'violet', 'rose', 'amber', 'sky'].map((value) => ({ value, label: value[0].toUpperCase() + value.slice(1) }))} onChange={actions.setAccent} />
					<SelectRow name="language" label={strings.language} value={settings.language} options={LANGUAGES.map((label, i) => ({ value: i === 0 ? 'auto' : label, label }))} onChange={(value) => actions.setSetting('language', value)} />
					<SelectRow name="spoken" label={strings.spokenLanguage} value={settings.spoken} options={LANGUAGES.map((label, i) => ({ value: i === 0 ? 'auto' : label, label }))} onChange={(value) => actions.setSetting('spoken', value)} />
					<SwitchRow name="followUps" label={strings.showFollowUps} checked={settings.followUps} onChange={(value) => actions.setSetting('followUps', value)} />
					</>
				}
				@if (tab !== 'general' || showAds) {
					<>
					<SwitchRow name="personalizedAds" label={strings.personalizedAds} hint={strings.personalizedAdsHint} checked={settings.personalizedAds} onChange={(value) => actions.setSetting('personalizedAds', value)} />
					<SwitchRow name="improveModel" label={strings.improveModel} hint={strings.improveModelHint} checked={settings.improveModel} onChange={(value) => actions.setSetting('improveModel', value)} />
					</>
				}
			</div>
		</div>
	</div>
}
